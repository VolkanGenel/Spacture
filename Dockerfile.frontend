# Dockerfile.frontend - Angular Frontend için
FROM node:18-alpine as build

WORKDIR /app

# 1. Package dosyalarını kopyala
COPY Frontend/video-clip-frontend/package*.json ./

# 2. Bağımlılıkları yükle
RUN npm install -g @angular/cli
RUN npm install

# 3. Uygulama kodunu kopyala
COPY Frontend/video-clip-frontend/ .

# 4. Angular uygulamasını build et
RUN ng build --configuration production

# 5. Nginx ile serve etmek için ikinci stage
FROM nginx:alpine

# 6. Build output'unu nginx'e kopyala
COPY --from=build /app/dist/video-clip-frontend /usr/share/nginx/html

# 7. Nginx konfigürasyonunu kopyala
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 8. Port'u aç
EXPOSE 80

# 9. Nginx'i başlat
CMD ["nginx", "-g", "daemon off;"]
